# Copy this file to `.env` (same folder) and fill in your own values. `.env` is git-ignored.
# NEVER commit real credentials and never put them in README, source code or the frontend.

# ---------------- Backend ----------------
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string (required). Use YOUR database-user password in your local .env only.
# If the password contains special characters (@ : / ? # %), URL-encode them (e.g. @ -> %40).
# Atlas -> Network Access must allow your current IP address.
MONGO_URI=mongodb+srv://YOUR_DB_USERNAME:YOUR_ACTUAL_PASSWORD@cluster0.xsfbzk1.mongodb.net/?appName=Cluster0
# Database name used inside your Atlas cluster
MONGO_DB_NAME=routemind

# Long random string, e.g.:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173

# URL of the Python FastAPI ML service
ML_SERVICE_URL=http://localhost:8000
# ML_FALLBACK=on  -> if the ML service is down, use a clearly-labelled rule-of-thumb. off -> fail with an error.
ML_FALLBACK=on

# ---------------- Real map services (OpenStreetMap ecosystem) ----------------
# Nominatim: converts place names into coordinates (called only when the user submits a search)
GEOCODE_URL=https://nominatim.openstreetmap.org/search
# Nominatim policy: identify your application. Optionally add a contact e-mail (sent as `email=`).
GEOCODE_USER_AGENT=RouteMindAI/1.0
GEOCODE_EMAIL=
# Optional: restrict results to some countries, e.g. "in" for India
GEOCODE_COUNTRY_CODES=
# OSRM: real road routing (NOT live traffic)
OSRM_URL=https://router.project-osrm.org

# ---------------- OpenStreetMap Overpass (Better Road Conditions / Better Scenery) ----------------
# Only called when a search asks for road conditions or scenery. Public servers: keep requests light (throttled, cached 24 h).
# The public instances are volunteer-run and each one is overloaded now and then, so a list is used: a timeout, HTTP 429,
# 5xx or network error moves on to the next endpoint. Priority order, comma-separated, whole-planet instances only.
# For heavy use run your own Overpass instance and put it FIRST (e.g. http://overpass:80/api/interpreter). No API key is needed.
OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.openstreetmap.fr/api/interpreter,https://overpass.kumi.systems/api/interpreter,https://overpass.private.coffee/api/interpreter
# OVERPASS_URL=                   # legacy single endpoint (ignored when OVERPASS_URLS is set). Leave empty to use the list above.
# OVERPASS_USER_AGENT=            # default: GEOCODE_USER_AGENT. Public servers ask you to identify your app, e.g. "RouteMindAI/1.0 (you@example.org)"
# OVERPASS_TIMEOUT_MS=20000       # per HTTP attempt (per endpoint)
# OVERPASS_BUDGET_MS=45000        # total time allowed for road + scenery per search; after that they show "unavailable"
# OVERPASS_MIN_INTERVAL_MS=1100   # minimum gap between requests to the SAME endpoint
# OVERPASS_CACHE_TTL_MS=86400000  # 24 h
# OVERPASS_COOLDOWN_MS=30000      # after all endpoints failed, do not ask the same question again for this long
# OVERPASS_CONCURRENCY=2           # parallel requests for ONE search (public servers allow ~2 slots per IP)
# OVERPASS_ABORT_AFTER_FAILURES=3 # this many failures before any success -> the rest of that search is not sent
# OVERPASS_ENDPOINT_FAILURES=2    # consecutive failed requests before an endpoint is skipped (429 / Retry-After: at once)
# OVERPASS_RETRIES=1              # extra passes over endpoints that failed FAST (5xx / network error); never after a timeout or 429
# OVERPASS_BACKOFF_MS=1000        # wait before the extra pass; doubles per pass (plus jitter)
# OVERPASS_ENDPOINT_COOLDOWN_MS=30000      # a failing endpoint is skipped for this long; doubles per consecutive failure ...
# OVERPASS_ENDPOINT_COOLDOWN_MAX_MS=300000 # ... up to this (a server's Retry-After is honoured up to the same limit)
# ROAD_QUALITY=on                 # off = never query road tags (reports "Road quality data unavailable")
# SCENERY=on                      # off = never query POIs (reports "Scenery information unavailable")
# ROAD_SAMPLE_SPACING_M=2000      # one sample point per this many metres of route ...
# ROAD_MAX_SAMPLES=30             # ... at most this many per route
# ROAD_SAMPLES_PER_REQUEST=20     # road samples are sent to Overpass in requests of at most this many statements
# ROAD_MIN_COVERAGE=0.2           # share of the route that must have a documented surface/smoothness tag to rank on it
# SCENERY_NEAR_M=300              # POI within this distance of the route: full weight
# SCENERY_MAX_M=1000              # POI within this distance: half weight (SCENERY_RING_WEIGHT); farther: ignored
# SCENERY_SEGMENT_KM=20            # each route is cut into segments of ~this length; one small Overpass request per segment
# SCENERY_MAX_REQUESTS=14         # max scenery requests per search (segments get longer for long routes; beyond that: "too long")
# SCENERY_MIN_COVERAGE=0.7        # share of EVERY route that must be retrieved to still give a score (flagged "incomplete" below 100 %)
# SCENERY_MAX_PER_CATEGORY=5      # only the best N places per category count
# SCENERY_SATURATION_K=10         # scenery score = 100 * (1 - exp(-points / K))
# DETOUR_DEFAULT_PERCENT=15       # meaning of "don't want to travel much longer"
# MAX_DETOUR_PERCENT=50           # road/scenery preferences never recommend a route slower than this vs the fastest

# ---------------- Optional AI (LLM) ----------------
# Leave AI_API_KEY empty to use the built-in rule-based AI. Any OpenAI-compatible endpoint works.
AI_API_KEY=
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini

# ---------------- Cost model (INR, rough estimate) ----------------
COST_PER_KM=7
TOLL_PER_KM=1.2

# ---------------- ML service ----------------
TRAFFIC_MULTIPLIERS=LOW=1.05,MEDIUM=1.20,HIGH=1.45

# ---------------- Developer diagnostics ----------------
# on -> GET /api/diagnostics returns per-service call counters (no credentials). Default: on in development.
DIAGNOSTICS=on

# ---------------- Docker compose ports ----------------
BACKEND_PORT=5000
ML_PORT=8000
FRONTEND_PORT=8080
